<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode's INFOPLIST_KEY_* generation drops for this target.
	     Without UIBackgroundModes=audio, iOS suspends the app on screen
	     lock and playback stops, even though AudioSessionManager sets the
	     .playback category. GENERATE_INFOPLIST_FILE stays YES, so Xcode
	     merges its generated keys on top of this partial file. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- CarPlay audio browsing. INFOPLIST_KEY_UIApplicationSceneManifest_Generation
	     is NO for this target so Xcode does not generate a competing manifest;
	     this one is the whole thing. Only the CarPlay role is declared: the
	     SwiftUI App lifecycle supplies the phone/iPad window scene itself.
	     CarPlay also needs the com.apple.developer.carplay-audio entitlement
	     (Config/Sonora.entitlements) on the signing profile. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
